{
  "name": "miri-housing-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --config wrangler.jsonc --port 8787",
    "test": "vitest run",
    "build": "tsc -b && tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --strict --skipLibCheck worker/index.ts && vite build",
    "preview": "vite preview",
    "deploy:api": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "postgres": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
